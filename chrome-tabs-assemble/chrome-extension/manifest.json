{
  "manifest_version": 3,
  "name": "Chrome Tabs Assemble",
  "description": "Moves every tab from all normal windows into the current window, keeping pinned tabs and tab groups.",
  "version": "1.0.0",
  "minimum_chrome_version": "121",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["tabGroups", "storage"],
  "background": {
    "service_worker": "background.js"
  }
}
